# Copy to .env and adjust.

# Port the app listens on (inside and outside the container).
PORT=8080

# Host address the port is bound to. Keep 127.0.0.1 unless the Cloudflare
# tunnel runs on another machine, then use this server's LAN IP.
BIND_ADDR=127.0.0.1

# Seed value for the DZD per EUR rate. Only used on first start; change it
# later in Settings.
DEFAULT_RATE=275

# Timezone for "today", month boundaries and the backup schedule.
TZ=Africa/Algiers

# Backups (spec §13). Cron schedule, in TZ above.
BACKUP_CRON=0 3 * * *
BACKUP_RETENTION_DAYS=30

# rclone remote name (from `rclone config`) and folder on it.
RCLONE_REMOTE=gdrive
RCLONE_PATH=cairn-backups

# Folder holding rclone.conf on this machine. Defaults to ~/.config/rclone.
# RCLONE_CONFIG_DIR=/home/you/.config/rclone
